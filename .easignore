# EAS Build ignore — keeps the upload tarball small.
# EAS prefers this file over .gitignore when present.
# Anything we do NOT need on the EAS build VM should be listed here.

# --- Dependencies (EAS re-installs from lockfile) ---
**/node_modules/
.pnpm-store/

# --- Backend service (mobile build does not need it) ---
services/

# --- Native folders generated by Expo prebuild (EAS prebuilds on its own) ---
apps/mobile/ios/
apps/mobile/android/

# --- Build / cache output ---
**/.expo/
**/.expo-shared/
**/dist/
**/build/
**/.next/
**/.turbo/
**/.cache/
**/coverage/
**/*.tsbuildinfo

# --- Python (in case anything sneaks in) ---
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# --- Local env / secrets ---
.env
.env.local
.env.*.local
**/.env.local
!.env.example
!**/.env.example

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Git / CI internals ---
.git/
.github/

# --- Logs ---
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# --- PlanFlow / tooling state ---
.planflow/
