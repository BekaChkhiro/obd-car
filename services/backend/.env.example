# Environment: development | staging | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated allowed CORS origins (Expo dev defaults)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Anthropic — required for Claude API calls
ANTHROPIC_API_KEY=sk-ant-...

# SQLite database path (relative to service root)
DB_PATH=db/obd.db

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# SMS delivery (sender.ge) — leave blank and verification codes are logged
# instead of sent, which is what you want in development
SENDER_GE_API_KEY=

# Reserved numbers for App Store review, "phone:code,phone:code" — these skip
# sender.ge and the resend cooldown so a reviewer with a non-Georgian number
# can still sign in. Leave blank outside of the App Store review build.
# Example: TEST_PHONE_NUMBERS=+995555000001:8264
TEST_PHONE_NUMBERS=

# Phone verification codes
PHONE_CODE_TTL_MINUTES=5
PHONE_CODE_MAX_ATTEMPTS=5
PHONE_CODE_RESEND_SECONDS=60
PHONE_CODE_HOURLY_LIMIT=5

# Rate limit applied to /auth/* endpoints (slowapi syntax)
AUTH_RATE_LIMIT=10/minute

# Per-IP rate limit for /auth/request-code specifically — each send costs
# real money, so this is tighter than the general auth limit above.
SMS_REQUEST_IP_RATE_LIMIT=10/hour

# Rate limit applied to AI assistant turns per user (per-user, not per-IP)
AI_RATE_LIMIT=20/hour

# Maximum tokens (input + output) per WebSocket diagnostic session; 0 = unlimited.
# Set explicitly in production to prevent runaway Anthropic spend.
SESSION_TOKEN_BUDGET=200000

# Sentry crash reporting — leave blank to disable
SENTRY_DSN=
